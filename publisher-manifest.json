          "version": 3,
          "body": "<style>\n*{box-sizing:border-box;margin:0;padding:0}\nhtml,body{font-family:\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",sans-serif;color:#3a2428;background:#f7f1e6;line-height:1.7;-webkit-font-smoothing:antialiased}\nbody{overflow-x:hidden}\na{color:#7a1f2b;text-decoration:none;border-bottom:1px dashed #c8a39a}\na:hover{color:#5a131e;border-bottom-style:solid}\n.wrap{max-width:1180px;margin:0 auto;padding:0 24px}\n\n/* ---------- 全宽色带分层堆叠 Hero ---------- */\n.hero{position:relative;width:100%}\n.band{width:100%;display:block}\n.band-a{background:#7a1f2b;color:#f7f1e6;padding:64px 0 56px}\n.band-b{background:#9a2b3a;color:#f7f1e6;padding:28px 0}\n.band-c{background:#f7f1e6;color:#3a2428;padding:44px 0 56px;border-top:1px dashed #c8a39a;border-bottom:1px dashed #c8a39a}\n.band-d{background:#efe2c8;color:#3a2428;padding:40px 0}\n\n.eyebrow{font-size:13px;letter-spacing:.18em;text-transform:uppercase;opacity:.85;margin-bottom:14px}\nh1.brand{font-size:clamp(44px,7vw,84px);font-weight:800;line-height:1.05;letter-spacing:-.02em;margin-bottom:18px}\n.tagline{font-size:clamp(15px,1.6vw,18px);max-width:680px;opacity:.92}\n.hero-meta{display:flex;flex-wrap:wrap;gap:18px 36px;margin-top:28px;font-size:14px}\n.hero-meta span{display:inline-flex;align-items:center;gap:8px}\n.hero-meta span::before{content:\"\";width:6px;height:6px;background:#f7f1e6;border-radius:50%;display:inline-block}\n.band-c .hero-meta span::before{background:#7a1f2b}\n\n.lede{margin-top:6px;font-size:15px;max-width:760px;color:#5a3a3f}\n.lede strong{color:#7a1f2b}\n\n.inpage-jump{display:flex;flex-wrap:wrap;gap:10px 14px;margin-top:22px;font-size:14px}\n.inpage-jump a{color:#7a1f2b;border-bottom:1px dashed #c8a39a;padding-bottom:1px}\n\n/* ---------- 区块通用 ---------- */\nsection.block{padding:72px 0;position:relative}\nsection.block h2{font-size:clamp(26px,3.4vw,36px);font-weight:700;margin-bottom:14px;letter-spacing:-.01em}\nsection.block h3{font-size:18px;font-weight:700;margin-bottom:8px;color:#3a2428}\nsection.block p.lead{font-size:15px;max-width:720px;color:#5a3a3f;margin-bottom:36px}\n\nsection.dark{background:#7a1f2b;color:#f7f1e6}\nsection.dark h2,section.dark h3{color:#f7f1e6}\nsection.dark p.lead{color:#e9d9c9}\nsection.dark a{color:#f7f1e6;border-bottom-color:#c8897f}\n\nsection.warm{background:#efe2c8}\nsection.light{background:#f7f1e6}\n\n/* ---------- 票据风格卡片 ---------- */\n.ticket{background:#fbf6ec;border:1px dashed #b8897f;border-radius:6px;padding:22px 24px;position:relative}\n.ticket + .ticket{margin-top:18px}\n.ticket .perforation{position:absolute;top:-1px;bottom:-1px;left:-7px;width:14px;background:radial-gradient(circle at 0 50%,#f7f1e6 4px,transparent 5px) repeat-y;background-size:14px 14px}\nsection.dark .ticket{background:#8a2531;border-color:#d9a89e}\nsection.dark .ticket .perforation{background:radial-gradient(circle at 0 50%,#7a1f2b 4px,transparent 5px) repeat-y;background-size:14px 14px}\nsection.warm .ticket{background:#fdf6e3;border-color:#b8897f}\n\n.ticket h3{font-size:17px;margin-bottom:6px}\n.ticket .meta{font-size:13px;color:#7a4d54;margin-bottom:12px}\nsection.dark .ticket .meta{color:#e9d9c9}\n\nul.checklist{list-style:none;font-size:14px}\nul.checklist li{padding:6px 0 6px 24px;position:relative;border-bottom:1px dotted #d9c2a8}\nul.checklist li:last-child{border-bottom:0}\nsection.dark ul.checklist li{border-bottom-color:#a85a64}\nul.checklist li::before{content:\"✓\";position:absolute;left:0;top:6px;color:#7a1f2b;font-weight:700}\nsection.dark ul.checklist li::before{color:#f7f1e6}\n\n/* ---------- 阶梯式套餐 ---------- */\n.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:0;align-items:stretch}\n.plan{position:relative;padding:30px 26px;background:#fbf6ec;border:1px dashed #b8897f;margin:0 -1px 0 0}\n.plan:nth-child(1){transform:translateY(18px)}\n.plan:nth-child(2){transform:translateY(0);background:#fdf6e3;z-index:2;box-shadow:0 12px 30px -16px rgba(122,31,43,.35)}\n.plan:nth-child(3){transform:translateY(36px)}\n.plan.featured::after{content:\"推荐\";position:absolute;top:-12px;right:18px;background:#7a1f2b;color:#f7f1e6;font-size:12px;letter-spacing:.1em;padding:4px 10px;border-radius:2px}\n.plan h3{font-size:20px;margin-bottom:4px}\n.plan .price{font-size:30px;font-weight:800;color:#7a1f2b;margin:10px 0 4px;letter-spacing:-.01em}\n.plan .price small{font-size:13px;font-weight:500;color:#7a4d54;margin-left:4px}\n.plan .annual{font-size:13px;color:#7a4d54;margin-bottom:18px;padding-bottom:14px;border-bottom:1px dotted #d9c2a8}\n.plan ul.checklist li{font-size:13.5px}\n.plan .note{margin-top:18px;font-size:12px;color:#7a4d54;line-height:1.6}\n\n@media (max-width:820px){\n  .plans{grid-template-columns:1fr;gap:24px}\n  .plan,.plan:nth-child(1),.plan:nth-child(2),.plan:nth-child(3){transform:none;margin:0}\n}\n\n/* ---------- FAQ 按主题分组 ---------- */\n.faq-group{margin-bottom:36px}\n.faq-group h3{font-size:16px;letter-spacing:.08em;text-transform:uppercase;color:#7a1f2b;margin-bottom:14px;padding-bottom:8px;border-bottom:1px dashed #b8897f}\n.faq-group details{background:#fbf6ec;border:1px dashed #b8897f;border-radius:4px;margin-bottom:10px}\n.faq-group details[open]{background:#fdf6e3}\n.faq-group summary{cursor:pointer;padding:14px 18px;font-size:15px;font-weight:600;list-style:none;position:relative}\n.faq-group summary::-webkit-details-marker{display:none}\n.faq-group summary::after{content:\"+\";position:absolute;right:18px;top:50%;transform:translateY(-50%);font-size:18px;color:#7a1f2b;font-weight:400}\n.faq-group details[open] summary::after{content:\"−\"}\n.faq-group details .answer{padding:0 18px 16px;font-size:14px;color:#5a3a3f;line-height:1.8}\n.faq-group details .answer p + p{margin-top:8px}\n\n/* ---------- 客户端区块 ---------- */\n.clients{padding:56px 0;background:#efe2c8;border-top:1px dashed #b8897f;border-bottom:1px dashed #b8897f}\n.clients h2{margin-bottom:8px}\n.clients p.lead{margin-bottom:26px}\n.client-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}\n.client-card{padding:18px 20px;background:#f7f1e6;border:1px dashed #b8897f;border-radius:4px}\n.client-card .row{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px}\n.client-card .row strong{font-size:15px;color:#3a2428}\n.client-card .row span{font-size:12px;color:#7a4d54;letter-spacing:.05em;text-transform:uppercase}\n.client-card p{font-size:13.5px;color:#5a3a3f}\n@media (max-width:640px){.client-grid{grid-template-columns:1fr}}\n\n/* ---------- 页脚 ---------- */\nfooter.site{padding:36px 0 28px;background:#3a2428;color:#e9d9c9;font-size:13px}\nfooter.site .row{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;align-items:center}\nfooter.site a{color:#e9d9c9;border-bottom-color:#7a4d54}\nfooter.site small{opacity:.75}\n</style><main>\n\n\n<div class=\"hero\">\n  <div class=\"band band-a\">\n    <div class=\"wrap\">\n      <div class=\"eyebrow\">节点订阅 · 按月计费 · 多设备接入</div>\n      <h1 class=\"brand\">Everlife</h1>\n      <p class=\"tagline\">一份长期稳定的订阅服务,把日常网络接入、流媒体观看与多设备协作的需求,放进同一张可预期的清单里。</p>\n      <div class=\"hero-meta\">\n        <span>三档流量套餐</span>\n        <span>最多 20 台设备同连</span>\n        <span>原生流媒体解锁</span>\n        <span>7×24 优先工单</span>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"band band-b\">\n    <div class=\"wrap\">\n      <nav class=\"inpage-jump\" aria-label=\"页内导航\">\n        <a href=\"#what\">服务说明</a>\n        <a href=\"#scenes\">使用场景</a>\n        <a href=\"#plans\">套餐与价格</a>\n        <a href=\"#start\">开通步骤</a>\n        <a href=\"#clients\">客户端支持</a>\n        <a href=\"#faq\">常见问题</a>\n      </nav>\n    </div>\n  </div>\n\n  <div class=\"band band-c\">\n    <div class=\"wrap\">\n      <p class=\"lede\">\n        <strong>Everlife</strong> 不是一次性的工具下载,而是一份按月续订的网络接入服务。我们把节点、流量、设备数与支持通道,做成可以提前核算的清单条目,让你在每月底都能清楚知道下个月该续什么、改什么、停什么。\n      </p>\n    </div>\n  </div>\n\n  <div class=\"band band-d\">\n    <div class=\"wrap\">\n      <p class=\"lede\">本页包含:服务范围说明 · 三档套餐逐项清单 · 开通与续订步骤 · 客户端支持情况 · 按主题整理的常见问题。</p>\n    </div>\n  </div>\n</div>\n\n\n<section class=\"block light\" id=\"what\">\n  <div class=\"wrap\">\n    <h2>服务说明</h2>\n    <p class=\"lead\">Everlife 提供的是订阅式节点服务,你按月或按年付费,获得对应档位的流量额度、设备并发数与节点池。下面列出我们目前在售的服务清单与边界条件。</p>\n\n    <div class=\"ticket\"><span class=\"perforation\"></span>\n      <h3>服务范围</h3>\n      <div class=\"meta\">清单条目 · 持续维护</div>\n      <ul class=\"checklist\">\n        <li>提供按月或按年订阅的节点接入服务</li>\n        <li>三档流量套餐,覆盖 100GB 至 1000GB 月度额度</li>\n        <li>支持多设备同时在线,最高 20 台并发</li>\n        <li>提供基础与原生两种流媒体解锁能力</li>\n        <li>提供 IPLC 专线、游戏加速、企业定制路由等附加能力</li>\n        <li>提供工单支持与专属客户经理两种服务通道</li>\n      </ul>\n    </div>\n\n    <div class=\"ticket\"><span class=\"perforation\"></span>\n      <h3>不在服务范围内的内容</h3>\n      <div class=\"meta\">清单条目 · 请提前知悉</div>\n      <ul class=\"checklist\">\n        <li>不提供一次性买断的永久授权</li>\n        <li>不承诺任何形式的退款(详见 FAQ)</li>\n        <li>不提供节点之外的服务器托管、域名注册等业务</li>\n        <li>不在订阅周期内额外赠送流量</li>\n      </ul>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"block warm\" id=\"scenes\">\n  <div class=\"wrap\">\n    <h2>使用场景</h2>\n    <p class=\"lead\">三档套餐分别对应不同的使用强度,下面是常见的搭配方式,供你按需对号入座。</p>\n\n    <div class=\"ticket\"><span class=\"perforation\"></span>\n      <h3>个人日常 · 基础版</h3>\n      <div class=\"meta\">适用:浏览、视频、偶尔远程办公</div>\n      <ul class=\"checklist\">\n        <li>3 台设备同时在线,覆盖手机、电脑、平板</li>\n        <li>100GB 月度流量,适合中等强度的日常使用</li>\n        <li>基础流媒体解锁,满足常规观看需求</li>\n        <li>普通线路节点池,作为默认接入通道</li>\n      </ul>\n    </div>\n\n    <div class=\"ticket\"><span class=\"perforation\"></span>\n      <h3>深度使用 · 旗舰版</h3>\n      <div class=\"meta\">适用:多设备并发、游戏、流媒体全家桶</div>\n      <ul class=\"checklist\">\n        <li>5 台设备同时在线,可覆盖家庭或小型工作室</li>\n        <li>300GB 月度流量,适合重度使用</li>\n        <li>全节点原生流媒体解锁,覆盖更广的内容库</li>\n        <li>IPLC 专线用于游戏加速,降低延迟波动</li>\n        <li>7×24 优先工单支持,响应更及时</li>\n      </ul>\n    </div>\n\n    <div class=\"ticket\"><span class=\"perforation\"></span>\n      <h3>团队协作 · 团队版</h3>\n      <div class=\"meta\">适用:中小团队、跨境业务、定制路由</div>\n      <ul class=\"checklist\">\n        <li>20 台设备同时在线,可覆盖整个小团队</li>\n        <li>1000GB 月度流量,适合多人并发使用</li>\n        <li>VIP 专属高带宽节点,保障团队整体体验</li>\n        <li>支持企业定制路由,按业务需求调整</li>\n        <li>专属客户经理服务,统一对接续订与变更</li>\n      </ul>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"block dark\" id=\"plans\">\n  <div class=\"wrap\">\n    <h2>套餐与价格</h2>\n    <p class=\"lead\">按月付或按年付两种方式,所有套餐均为订阅制,所列价格为月度参考价,按年付一次性结算。</p>\n\n    <div class=\"plans\">\n      <div class=\"plan\">\n        <h3>基础版</h3>\n        <div class=\"meta\">个人日常 · 入门档位</div>\n        <div class=\"price\">¥15<small>/月</small></div>\n        <div class=\"annual\">按年付仅需 ¥150/年</div>\n        <ul class=\"checklist\">\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n        <div class=\"note\">适合刚开始使用、对设备数和流量要求不高的个人用户。</div>\n      </div>\n\n      <div class=\"plan featured\">\n        <h3>旗舰版</h3>\n        <div class=\"meta\">深度使用 · 高性价比档位</div>\n        <div class=\"price\">¥35<small>/月</small></div>\n        <div class=\"annual\">按年付仅需 ¥350/年</div>\n        <ul class=\"checklist\">\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7×24 优先工单支持</li>\n        </ul>\n        <div class=\"note\">多数家庭与重度个人用户的默认选择,覆盖看片、游戏、远程办公三类需求。</div>\n      </div>\n\n      <div class=\"plan\">\n        <h3>团队版</h3>\n        <div class=\"meta\">团队协作 · 高并发档位</div>\n        <div class=\"price\">¥85<small>/月</small></div>\n        <div class=\"annual\">按年付仅需 ¥850/年</div>\n        <ul class=\"checklist\">\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n        <div class=\"note\">面向 5 人以上、需要统一管理与高带宽保障的中小团队。</div>\n      </div>\n    </div>\n\n    <p class=\"lead\">所有套餐均为订阅制,所列价格为月度参考价,按年付一次性结算。流量额度、设备并发数与服务通道在订阅周期内固定,变更需在续订时调整。</p>\n  </div>\n</section>\n\n\n<section class=\"block light\" id=\"start\">\n  <div class=\"wrap\">\n    <h2>开通步骤</h2>\n    <p class=\"lead\">从选择套餐到正式使用,下面是标准的开通清单,按顺序执行即可。</p>\n\n    <div class=\"ticket\"><span class=\"perforation\"></span>\n      <h3>第一步 · 选择套餐</h3>\n      <div class=\"meta\">清单条目</div>\n      <ul class=\"checklist\">\n        <li>根据设备数与流量需求,在三档中选择合适的档位</li>\n        <li>确认按月付或按年付的结算方式</li>\n        <li>记下所选套餐对应的流量与并发数</li>\n      </ul>\n    </div>\n\n    <div class=\"ticket\"><span class=\"perforation\"></span>\n      <h3>第二步 · 完成订阅</h3>\n      <div class=\"meta\">清单条目</div>\n      <ul class=\"checklist\">\n        <li>在订阅页填写账号信息</li>\n        <li>选择支付方式完成付款</li>\n        <li>保存订阅成功的确认信息</li>\n      </ul>\n    </div>\n\n    <div class=\"ticket\"><span class=\"perforation\"></span>\n      <h3>第三步 · 导入节点</h3>\n      <div class=\"meta\">清单条目</div>\n      <ul class=\"checklist\">\n        <li>获取订阅链接或节点信息</li>\n        <li>在所选客户端中导入订阅</li>\n        <li>刷新节点列表,验证连接状态</li>\n      </ul>\n    </div>\n\n    <div class=\"ticket\"><span class=\"perforation\"></span>\n      <h3>第四步 · 续订与变更</h3>\n      <div class=\"meta\">清单条目</div>\n      <ul class=\"checklist\">\n        <li>在订阅到期前完成续订</li>\n        <li>需要调整套餐档位时,在续订时同步变更</li>\n        <li>不再使用时,到期后不续订即可</li>\n      </ul>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"clients\" id=\"clients\">\n  <div class=\"wrap\">\n    <h2>客户端支持</h2>\n    <p class=\"lead\">Everlife 的订阅信息可导入常见的客户端使用,具体可用版本以客户端官方发布为准。</p>\n\n    <div class=\"client-grid\">\n      <div class=\"client-card\">\n        <div class=\"row\"><strong>Windows</strong><span>桌面端</span></div>\n        <p>适用于 Windows 10 及以上系统,导入订阅后即可在桌面端使用节点服务。</p>\n      </div>\n      <div class=\"client-card\">\n        <div class=\"row\"><strong>macOS</strong><span>桌面端</span></div>\n        <p>适用于 macOS 桌面环境,适合使用苹果电脑的个人与团队成员。</p>\n      </div>\n      <div class=\"client-card\">\n        <div class=\"row\"><strong>iOS</strong><span>移动端</span></div>\n        <p>适用于 iPhone 与 iPad,具体可用版本以 App Store 与客户端官方说明为准。</p>\n      </div>\n      <div class=\"client-card\">\n        <div class=\"row\"><strong>Android</strong><span>移动端</span></div>\n        <p>适用于 Android 手机与平板,导入订阅链接后即可使用。</p>\n      </div>\n      <div class=\"client-card\">\n        <div class=\"row\"><strong>路由器</strong><span>网关级</span></div>\n        <p>适用于支持相关协议的路由器固件,可作为家庭或办公室的统一网关。</p>\n      </div>\n      <div class=\"client-card\">\n        <div class=\"row\"><strong>Linux</strong><span>桌面端</span></div>\n        <p>适用于常见 Linux 桌面发行版,适合开发者与技术型用户。</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"block warm\" id=\"faq\">\n  <div class=\"wrap\">\n    <h2>常见问题</h2>\n    <p class=\"lead\">按主题整理了订阅前与使用中常被问到的问题,如果你没有找到答案,可在工单系统中提交咨询。</p>\n\n    <div class=\"faq-group\">\n      <h3>订阅与续订</h3>\n\n      <details>\n        <summary>Everlife 的订阅周期是多久?</summary>\n        <div class=\"answer\">\n          <p>订阅周期分为按月付与按年付两种。按月付以自然月为单位,到期后可续订下一周期;按年付一次性结算 12 个月的费用,在订阅有效期内持续提供服务。</p>\n          <p>套餐档位与价格以订阅页公示内容为准。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>可以从基础版升到旗舰版或团队版吗?</summary>\n        <div class=\"answer\">\n          <p>支持升级。建议在当前订阅到期前完成升级操作,新档位的流量与设备数会在下一周期生效。</p>\n          <p>如果在当前周期内希望提前升级,可提交工单说明情况,由客服协助处理差额。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>到期不续订会怎样?</summary>\n        <div class=\"answer\">\n          <p>订阅到期后不续订,服务将自动停止,不再产生费用。已导入的节点信息将失效,需要重新订阅才能继续使用。</p>\n        </div>\n      </details>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3>套餐与流量</h3>\n\n      <details>\n        <summary>每月流量是如何计算的?</summary>\n        <div class=\"answer\">\n          <p>流量按自然月重置,自每月 1 日 0 点开始累计,至月末 24 点清零。月度流量额度为套餐对应数值,未使用完的部分不结转至下月。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>流量用完后还能继续使用吗?</summary>\n        <div class=\"answer\">\n          <p>流量用完后,当月剩余时间内服务将被限速或暂停,具体以客户端提示为准。下一周期开始后流量重置,可恢复正常使用。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>三档套餐的核心差别是什么?</summary>\n        <div class=\"answer\">\n          <p>核心差别体现在三个维度:月度流量额度、同时在线设备数、附加服务通道。</p>\n          <p>基础版适合轻度个人使用;旗舰版增加了原生流媒体、IPLC 游戏加速与优先工单;团队版进一步扩大并发数,并提供企业定制路由与专属客户经理。</p>\n        </div>\n      </details>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3>客户端与设备</h3>\n\n      <details>\n        <summary>支持哪些客户端与系统?</summary>\n        <div class=\"answer\">\n          <p>支持 Windows、macOS、iOS、Android、Linux 桌面端,以及部分支持相关协议的路由器固件。具体可用版本以客户端官方发布为准。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>同时在线的设备数怎么算?</summary>\n        <div class=\"answer\">\n          <p>同时在线指在相同时刻保持连接的唯一设备数量。例如旗舰版允许 5 台设备同时在线,超过后将无法建立新的连接,需断开已有设备后重试。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>订阅信息如何导入客户端?</summary>\n        <div class=\"answer\">\n          <p>在订阅成功后获取订阅链接或节点信息,粘贴到客户端对应的订阅地址栏,刷新节点列表即可看到可用节点。具体步骤请参考各客户端的使用文档。</p>\n        </div>\n      </details>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3>支持与售后</h3>\n\n      <details>\n        <summary>遇到连接问题该怎么反馈?</summary>\n        <div class=\"answer\">\n          <p>可通过工单系统提交问题,基础版与团队版的工单响应时间有所不同,旗舰版提供 7×24 优先工单支持。</p>\n          <p>提交工单时建议附上客户端类型、系统版本与问题截图,便于快速定位。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>提供退款吗?</summary>\n        <div class=\"answer\">\n          <p>订阅服务一经开通不支持退款,建议在购买前评估好流量与设备需求。</p>\n          <p>如因服务本身无法使用导致无法履约,可在工单中说明情况,由客服按个案处理。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>团队版可以指定专属客户经理吗?</summary>\n        <div class=\"answer\">\n          <p>可以。团队版订阅成功后,会在工单系统中指派专属客户经理,负责续订提醒、套餐变更与日常对接。</p>\n        </div>\n      </details>\n    </div>\n\n  </div>\n</section>\n\n</main>\n\n<footer class=\"site\">\n  <div class=\"wrap\">\n    <div class=\"row\">\n      <div><strong>Everlife</strong>   <small>节点订阅 · 按月计费 · 多设备接入</small></div>\n      <div>\n        <a href=\"#what\">服务说明</a>  \n        <a href=\"#plans\">套餐</a>  \n        <a href=\"#start\">开通步骤</a>  \n        <a href=\"#faq\">FAQ</a>\n      </div>\n    </div>\n  </div>\n</footer>",
